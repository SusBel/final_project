@startuml
class AppServer {
    +fastapi_app
    +chat(message, session_id)
}

class SessionManager {
    -sessions: dict
    +get_state(session_id)
    +update_state(session_id, state)
}

class InferencePipeline {
    +predict(text, prev_state)
}

class IntentModel {
    -weights: BiLSTM
    +classify(vector)
}

class EmotionModel {
    -weights: Dense
    +classify(vector)
}

class LogicEngine {
    -golden_set: DataFrame
    +find_nearest_action(intent, emotion, state)
}

AppServer --> SessionManager
AppServer --> InferencePipeline
InferencePipeline --> IntentModel
InferencePipeline --> EmotionModel
InferencePipeline --> LogicEngine
@enduml